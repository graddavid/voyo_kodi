<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="plugin.video.voyo.si" name="VOYO.si" version="1.0.1" provider-name="Antigravity">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.inputstreamhelper" version="0.5.0" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="sl_SI">Predvajalnik za VOYO.si</summary>
        <summary lang="en_GB">Kodi video add-on for VOYO.si</summary>
        <description lang="sl_SI">Neuradni VOYO.si vtičnik za Kodi. Omogoča prijavo z obstoječim VOYO.si računom, brskanje po bogati zbirki filmov, serij, oddaj ter ogled TV kanalov v živo (POP TV, Kanal A, KINO, BRIO, OTO, VOYO) z zaščito Widevine DRM.</description>
        <description lang="en_GB">Unofficial VOYO.si Kodi video plugin. Watch movies, series, shows and live TV channels with your VOYO.si subscription using Widevine DRM.</description>
        <platform>all</platform>
        <license>GPL-3.0-only</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="repository.voyo.si" name="VOYO.si Repository" version="1.0.0" provider-name="Antigravity">
    <extension point="xbmc.addon.repository" name="VOYO.si Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/graddavid/voyo_kodi/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/graddavid/voyo_kodi/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/graddavid/voyo_kodi/main/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="sl_SI">Skladišče dodatkov za VOYO.si</summary>
        <summary lang="en_GB">Kodi Add-on Repository for VOYO.si</summary>
        <description lang="sl_SI">Uradno skladišče za namestitev in samodejne posodobitve dodatka VOYO.si za Kodi.</description>
        <description lang="en_GB">Repository for installing and updating VOYO.si Kodi video add-on.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon></addons>